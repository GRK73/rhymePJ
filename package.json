{
  "name": "rhymepj",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "python -m http.server 4173 --bind 127.0.0.1 --directory public",
    "check": "node scripts/check_project.js",
    "validate:phonetic": "node scripts/validate_phonetic_search_pipeline.js --iterations=3 --stable-passes=3",
    "validate:linked": "node scripts/validate_linked_search_pipeline.js --iterations=3 --stable-passes=3",
    "extract:loanwords": "python scripts/extract_loanword_overrides.py",
    "convert:word2vec": "python scripts/convert_word2vec_to_json.py",
    "build:bigram": "python scripts/build_bigram_index.py",
    "build:surface-bigram": "python scripts/build_surface_bigram_index.py",
    "build:hiphop-stats": "python scripts/build_hiphop_stats.py",
    "collect:hiphop-hf": "python scripts/collect_hf_hiphop_dataset.py",
    "build:translated-hiphop": "python scripts/build_translated_hiphop_semantics.py",
    "build:english-hiphop-phonetics": "python scripts/build_english_hiphop_phonetic_patterns.py",
    "build:hiphop-rhyme": "python scripts/build_hiphop_rhyme_model.py --input-jsonl public/data/corpus/hiphop_corpus.jsonl",
    "build:structural-rhyme-rules": "python scripts/build_structural_rhyme_rules.py",
    "build:spoken-korean-aux": "python scripts/build_spoken_korean_aux.py",
    "enrich:korean-pronunciation": "node scripts/enrich_korean_pronunciations.js",
    "build:morph-cache": "python scripts/extract_korean_morph_cache.py public/data/model/rhyme_dict_practical.json scripts/cache/morph_analysis_ko.json",
    "build:compound-pronunciation": "node scripts/build_compound_pronunciations.js",
    "build:dict": "node scripts/build_dict.js && node scripts/enrich_korean_pronunciations.js public/data/model/rhyme_dict.json",
    "filter:dict": "python scripts/filter_corpus.py && node scripts/enrich_korean_pronunciations.js public/data/model/rhyme_dict_practical.json && node scripts/build_compound_pronunciations.js",
    "scrape:nikl": "node scripts/scrape_nikl.js",
    "test": "npm run check && npm run validate:phonetic && npm run validate:linked"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.0",
    "hangul-js": "^0.2.6",
    "p-limit": "^7.3.0",
    "rhymez": "^3.0.4"
  }
}
